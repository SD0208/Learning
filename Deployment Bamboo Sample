[string]$server=($ENV:bamboo_deploy_environment).Substring(0, ($ENV:bamboo_deploy_environment).lastindexof('-'))
[string]$folder=($ENV:bamboo_deploy_environment).Substring(($ENV:bamboo_deploy_environment).lastindexof('-')+1)

$command = '"C:\Program Files\7-Zip\7z.exe" e "artifacts\ssis.zip" -o"ssis\" -aoa'
Invoke-Expression "& $command"

[string]$theHost = hostname

# Clear the destination folder first so that no stale packages remain
if($theHost -eq "RDWUSHDBAM03C"){
[string]$x = 'C:\"Program Files (x86)"\"Microsoft SQL Server"\150\DTS\Binn\dtutil.exe /SourceServer $server /FDirectory "SQL;$folder" /Quiet'
$packageList = Invoke-Expression $x
"Running on Remote Agent"
} else {
$packageCommand = "/SourceServer $server /FDirectory `"SQL;$folder`" /Quiet"
$packageList = Invoke-Expression "dtutil $packageCommand"
"Running on Bamboo Primary Server"
}


foreach ($ssisPackage in $packageList) {
    if($ssisPackage -like '*(v*'){
        $rowPattern = [Regex]::new('[A-Za-z][A-ZA-z0-9 ]{4,}')
$match = $rowPattern.Matches($ssisPackage)
$package = $match.Value

$num=$package.length - 1

$package = $package.Substring(0,$num)
$package

if($theHost -eq "RDWUSHDBAM03C"){
[string]$xx = 'C:\"Program Files (x86)"\"Microsoft SQL Server"\150\DTS\Binn\dtutil.exe /SQL "$folder\$package" /DELETE /SourceServer $server'
Invoke-Expression $xx
} else {
$command = "/SQL `"$folder\$package`" /DELETE /SourceServer $server"
Invoke-Expression "dtutil $command"
}
}
}
# End Folder Clear


$files=Get-Childitem "ssis\"
foreach ($file in $files){
$package=$file -replace '.dtsx',''

if($theHost -eq "RDWUSHDBAM03C"){

[string]$y = 'C:\"Program Files (x86)"\"Microsoft SQL Server"\150\DTS\Binn\dtutil.exe /FILE ".\ssis\$file" /DestServer $server /COPY "SQL;$folder\$package" /Quiet'
$result = Invoke-Expression $y
"package: "
$package
} else {
$command = "/FILE `".\ssis\$file`" /DestServer $server /COPY `"SQL;$folder\$package`" /Quiet"
$command
$result = Invoke-Expression "dtutil $command"
}

    [string]$myError = $result | Select-String -Pattern 'Error'

    if (([string]::IsNullOrEmpty($myError))){
        $result
    } else {
        "The DTUtil command returned an error"
        "Exiting..."
        exit 1
    }
   
}
