if(Test-Path ".\artifacts\pre-release.zip"){
"******************  Deploying pre-deploy scripts  ******************"
$command = '"C:\Program Files\7-Zip\7z.exe" e ".\artifacts\pre-release.zip" *.sql -o".\artifacts\pre-release\" -aoa'
$command
Invoke-Expression "& $command"
if(Test-Path ".\artifacts\pre-release"){
Get-Childitem ".\artifacts\pre-release\" | Foreach {
"Executing $_.Name on $server for $database"
sqlcmd -E -b -S $server -d $database -i $_.FullName -f 65001
if($LASTEXITCODE -ne 0){
"Failed to deploy " + $_.Name
exit 1
}
}
}
}

if((Test-Path $package) -and (get-item $package).length -gt 0){
"******************  Deploying Data Model  ******************"
$ErrorActionPreference = "stop"
$filter=".\cm\Filter.scpf"
$databaseUpdateResourcesDirectory = "$drive\DatabaseUpdateResources\$project\$server\$version\$database\"
$options = "DecryptPost2kEncryptedObjects, IgnoreDataCompression, IgnoreDatabaseAndServerName, IgnoreFileGroups, IgnoreFillFactor, IgnoreUserProperties, IgnoreWhiteSpace, IgnoreWithElementOrder, IgnoreConstraintNames, IgnoreCollations, IncludeDependencies"
if ($database -match "dataloader|merlinra7|tepqmeops"){
$options = $options + ", -ForceColumnOrder, IgnoreFullTextIndexing"
}
If (Test-Path $databaseUpdateResourcesDirectory) {
rmdir $databaseUpdateResourcesDirectory -Recurse -Force
}
$dbconnection = New-DlmDatabaseConnection -ServerInstance $server -Database $database
$cred="-E"

$release = New-DlmDatabaseRelease -Source $package -Target $dbconnection -Verbose -SQLCompareOptions $options -IgnoreStaticData -IgnoreAdditional
Export-DlmDatabaseRelease $release -Path $databaseUpdateResourcesDirectory
Import-DlmDatabaseRelease $databaseUpdateResourcesDirectory | Use-DlmDatabaseRelease -DeployTo $dbconnection -SkipPostUpdateSchemaCheck -QueryBatchTimeout 1800

"testing $ENV:bamboo_build_working_directory"
$ENV:bamboo_build_working_directory
$deployprojecturl= $ENV:bamboo_build_working_directory
$deployprojecturl=$deployprojecturl.split("-")[-1]
"id: $deployprojecturl"
$bamboo_resultsUrl=$ENV:bamboo_resultsUrl
"url: $bamboo_resultsUrl"
$bamboo_resultsUrl = $bamboo_resultsUrl -replace "viewDeploymentResult.*","viewEnvironment.action?id=$deployprojecturl"
"url: '$bamboo_resultsUrl'"
# Log deploy info into database
$ENV:bamboo_planRepository_name = $ENV:bamboo_planRepository_name -replace "-int\d|-dev",""
sqlcmd -E -b -S $server -d $database -q "EXEC sp_INSERT_ModelVersion @BambooProject = '$ENV:bamboo_planKey', `
@BambooPlan = '$ENV:bamboo_shortPlanName', @BambooPlanURL = '$bamboo_resultsUrl', @BambooBuild = '$ENV:bamboo_buildNumber', `
@BambooRelease= '$ENV:bamboo_deploy_version', @GitRepo = '$ENV:bamboo_planRepository_name', @GitBranch = '$ENV:bamboo_planRepository_branchName', `
@GitCommit = '$ENV:bamboo_planRepository_revision';"

# Self cleanup, remove all folders that are older than 15 days
"Running self cleanup"
$cleanuppath="$drive\DatabaseUpdateResources\$project\$server\"
#Get-ChildItem $cleanuppath | Where-Object {$_.LastWriteTime -lt (Get-Date).AddDays(-15)}
#Get-ChildItem $cleanuppath | Where-Object {$_.LastWriteTime -lt (Get-Date).AddDays(-15)} | Remove-Item -Recurse -Force

}
